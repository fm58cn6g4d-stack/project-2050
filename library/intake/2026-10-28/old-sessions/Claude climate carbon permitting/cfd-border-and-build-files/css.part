<style>
/* Layout: a working tool. Controls rail on the left, results on the right, policy text and method below. */
:root{
  --bg:#f6f8f7; --surface:#fcfcfb; --ink:#0f1a17; --ink2:#4a5753; --ink3:#7b8783; --line:#dbe2df; --accent:#0d6b5c; --accent-soft:#e2efec;
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100; --s5:#e87ba4; --s6:#008300; --s7:#4a3aa7; --base:#8a9390; --band:#2a78d6; --warn:#a4510d;
  --display:"IBM Plex Serif",Georgia,serif; --body:"IBM Plex Sans",system-ui,sans-serif; --mono:"IBM Plex Mono",ui-monospace,monospace;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ color-scheme:dark;
  --bg:#111715; --surface:#1a1f1d; --ink:#f2f5f4; --ink2:#b9c4c0; --ink3:#87938f; --line:#2e3835; --accent:#5cc4b0; --accent-soft:#1d312d;
  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181; --s6:#008300; --s7:#9085e9; --base:#7d8885; --band:#3987e5; --warn:#e5a25f; } }
:root[data-theme="dark"]{ color-scheme:dark;
  --bg:#111715; --surface:#1a1f1d; --ink:#f2f5f4; --ink2:#b9c4c0; --ink3:#87938f; --line:#2e3835; --accent:#5cc4b0; --accent-soft:#1d312d;
  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181; --s6:#008300; --s7:#9085e9; --base:#7d8885; --band:#3987e5; --warn:#e5a25f; }
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.5}
.wrap{max-width:1180px;margin:0 auto;padding-inline:20px;padding-block:28px 64px;display:flex;flex-direction:column;gap:28px}
header h1{font-family:var(--display);font-weight:500;font-size:30px;line-height:1.15;margin:0;text-wrap:balance}
header p{margin:6px 0 0;color:var(--ink2);max-width:68ch}
nav{display:flex;gap:16px;flex-wrap:wrap;font-size:14px;margin-top:10px}
nav a{color:var(--accent)}
h2{font-family:var(--display);font-weight:500;font-size:22px;margin:0 0 4px;text-wrap:balance}
h3{font-size:14px;font-weight:600;margin:0}
.sub{color:var(--ink2);font-size:13px;margin:2px 0 0}
.grid{display:grid;grid-template-columns:280px minmax(0,1fr);gap:24px;align-items:start}
@media (max-width:860px){.grid{grid-template-columns:minmax(0,1fr)}}
.controls{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:16px;display:flex;flex-direction:column;gap:14px}
@media (min-width:861px){.controls{position:sticky;top:calc(env(safe-area-inset-top,0px) + 12px)}}
.ctl{display:flex;flex-direction:column;gap:4px}
.ctl label{font-size:13px;color:var(--ink2);display:flex;justify-content:space-between;gap:8px}
.ctl output{font-family:var(--mono);color:var(--ink);font-size:13px}
input[type=range]{width:100%;accent-color:var(--accent)}
select{font:inherit;font-size:14px;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);width:100%}
.check{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--ink2)}
.check input{accent-color:var(--accent)}
.group{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3);border-top:1px solid var(--line);padding-top:12px}
.group:first-child{border-top:0;padding-top:0}
button{font:inherit;font-size:13px;padding:7px 12px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);cursor:pointer}
button:hover{border-color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.results{display:flex;flex-direction:column;gap:24px;min-width:0}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:8px;overflow:hidden}
.tile{background:var(--surface);padding:12px 14px}
.tile .k{font-size:12px;color:var(--ink2)}
.tile .v{font-family:var(--mono);font-size:22px;font-weight:500;font-variant-numeric:tabular-nums;margin-top:2px}
.tile .r{font-size:12px;color:var(--ink3);font-family:var(--mono)}
.note{font-size:13px;color:var(--warn);margin:0}
.charts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:20px}
.chart{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:14px 14px 8px;position:relative;min-width:0}
.chart svg{display:block;width:100%;height:auto;overflow:visible}
.chart text{font-family:var(--body);font-size:11px;fill:var(--ink2)}
.legend{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:12px;color:var(--ink2);margin:6px 0 2px}
.legend i{display:inline-block;width:14px;height:3px;border-radius:2px;margin-right:5px;vertical-align:middle}
.legend i.sw{height:10px;width:10px}
.tip{position:absolute;pointer-events:none;background:var(--ink);color:var(--bg);font-size:12px;padding:6px 8px;border-radius:6px;line-height:1.4;white-space:nowrap;z-index:5;font-variant-numeric:tabular-nums}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{padding:6px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
td{font-family:var(--mono);font-variant-numeric:tabular-nums}
th{font-weight:600;color:var(--ink2);font-size:12px}
th:first-child,td:first-child{text-align:left}
td.txt,th.txt{text-align:left;font-family:var(--body);white-space:normal}
tr:last-child td{border-bottom:0}
.prose{max-width:72ch;display:flex;flex-direction:column;gap:10px}
.prose p,.prose ul{margin:0}
.prose ul{padding-left:20px}
.prose li{margin-bottom:6px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:18px 32px}
section{display:flex;flex-direction:column;gap:14px}
details summary{cursor:pointer;color:var(--accent);font-size:14px}
a{color:var(--accent)}

.checks{display:flex;flex-direction:column;gap:6px}
.kv td:first-child{font-family:var(--body)}
.tile:last-child{grid-column-end:-1}
</style>